rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      return request.auth != null &&
        request.auth.token.role in ['ADMIN', 'REVIEWER', 'ART_MANAGER', 'IMPACT_MANAGER'];
    }

    match /coloring-pages/{pageId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.role in ['ADMIN', 'ART_MANAGER'];
    }

    match /submissions/{submissionId}/original/{file} {
      allow read: if staff();
      allow write: if false;
    }

    match /submissions/{submissionId}/derived/{file} {
      allow read: if staff();
      allow write: if false;
    }

    match /gallery/{submissionId}/{file} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
