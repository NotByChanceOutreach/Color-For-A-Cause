rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : '';
    }
    function isAdmin() { return role() == 'ADMIN'; }
    function isReviewer() { return role() in ['ADMIN', 'REVIEWER']; }
    function isArt() { return role() in ['ADMIN', 'ART_MANAGER']; }
    function isImpact() { return role() in ['ADMIN', 'IMPACT_MANAGER']; }

    match /coloringPages/{id} {
      allow read: if resource.data.active == true || isArt();
      allow write: if isArt();
    }

    match /publicGallery/{id} {
      allow read: if resource.data.public == true;
      allow write: if isReviewer();
    }

    match /submissions/{id} {
      allow read, write: if isReviewer();
    }

    match /consents/{id} {
      allow read, write: if isReviewer();
    }

    match /consentDocuments/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /groups/{id} {
      allow read: if isReviewer();
      allow write: if isReviewer();
    }

    match /collectibles/{id} {
      allow read: if isReviewer() || isImpact();
      allow write: if isImpact() || isAdmin();
    }

    match /impactRecords/{id} {
      allow read: if isImpact() || isAdmin();
      allow write: if isImpact() || isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isReviewer();
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
